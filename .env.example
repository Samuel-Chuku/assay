# Copy to .env and fill in. Loaded by tsx via dotenv.
# T11: do not `source` this file in fish. Scripts read it themselves.

# Sepolia has no public RPC pinned in CLAUDE.md, so this one is required.
SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional. config/chains.ts defaults to the verified values when unset.
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/

# Needs tCTC on Creditcoin (Discord token-faucet) and ETH on Sepolia.
DEPLOYER_PRIVATE_KEY=
